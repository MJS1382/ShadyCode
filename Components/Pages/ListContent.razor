@page "/blog"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using PersonalBlog.Models
@using PersonalBlog.Data
@inject ApplicationDbContext DbContext

<div class="container p-0">
    <div class="p-2 mt-3 mx-md-5">
        <div class="d-flex justify-content-center align-items-center">
            <div class="flex-grow-1">
                    <input value="@textInput" @oninput="HandleSearchInput" class="form-control" />
            </div>
            <div class="ms-2">
                <button class="search-button btn btn-outline-light" type="reset" @onclick="() => SearchAsync()">
                    <i class="bi bi-search" alt="search"></i>
                </button>
            </div>
        </div>
        <div>
            @* tegs *@
        </div>
    </div>
    
    <div class="p-2">
        <div class="d-flex justify-content-center">
            <div class="p-0 d-flex flex-wrap justify-content-center align-items-center">
                @if (postCardItems != null && postCardItems.Any())
                {
                    @foreach (var item in postCardItems)
                    {
                        <div class="card m-3" style="width: 300px; height: 440px;">
                            <div style="height: 200px;">
                                <img src="@(item.ThumbnailPath)" class="card-img-top">
                            </div>
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="card-title">
                                        @(item.Title)
                                    </h5>
                                    <p class="card-text m-0">
                                        @((MarkupString)item.Contetnt!)
                                    </p>
                                </div>
                                <div>
                                    @foreach (var tag in item.Tags!)
                                    {
                                        <p class="d-inline-block mx-1 mb-1">@tag</p>
                                    }
                                    <NavLink  nk class="btn btn-primary d-block" href=@($"/blog/{item.Slug}")>Read</NavLink>
                                </div>
                            </div>
                        </div>
                    }
                }
                else if (!string.IsNullOrEmpty(textInput)) 
                {
                    <p class="text-center">No match</p>
                }
                else
                {
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="card m-3" style="width: 300px;" aria-hidden="true">
                            <img src="/img/empty.png" class="card-img-top" alt="...">
                            <div class="card-body">
                                <h5 class="card-title placeholder-glow">
                                <span class="placeholder col-6"></span>
                                </h5>
                                <p class="card-text placeholder-glow">
                                <span class="placeholder col-7"></span>
                                <span class="placeholder col-4"></span>
                                <span class="placeholder col-4"></span>
                                <span class="placeholder col-6"></span>
                                <span class="placeholder col-8"></span>
                                </p>
                                <a class="btn btn-primary disabled placeholder col-6" aria-disabled="true"></a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="d-flex justify-content-center mt-3">
            <nav>
                <ul class="pagination">
                    <li class="page-item @(pageNumber == 0 ? "disabled" : "")">
                        <button type="button" class="page-link" @onclick="() => LoadPageAsync(pageNumber - 1)" disabled="@(pageNumber == 0)">Previous</button>
                    </li>
                    @for (int page = 0; page < totalPages; page++)
                    {
                        var pageIndex = page;
                        <li class="page-item @(pageIndex == pageNumber ? "active" : "")">
                            <button type="button" class="page-link" @onclick="() => LoadPageAsync(pageIndex)">@(pageIndex + 1)</button>
                        </li>
                    }
                    <li class="page-item @(pageNumber >= totalPages - 1 ? "disabled" : "")">
                        <button type="button" class="page-link" @onclick="() => LoadPageAsync(pageNumber + 1)" disabled="@(pageNumber >= totalPages - 1)">Next</button>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

@code {
    public List<PostCardItem>? InitialItems { get; set; }
    public List<PostCardItem>? postCardItems { get; set; }

    string textInput = "";
    int pageNumber;
    int paginationNumber = 6;
    int totalPages;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        await LoadPageAsync(0);
        InitialItems = new(postCardItems!);
    }

    async Task SearchAsync()
    {
        textInput = textInput.Trim().ToLowerInvariant();

        await LoadPageAsync(0);
    }

    async Task LoadPageAsync(int page)
    {
        pageNumber = Math.Max(0, page);

        var posts = DbContext.Posts
            .AsNoTracking()
            .Where(p => p.PublishDate > DateTime.MinValue)
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(textInput))
        {
            posts = posts
                .Where(p => EF.Functions.ILike(p.Title, $"%{textInput}%") ||
                EF.Functions.ILike(p.Tags, $"%{textInput}%"));
        }

        var totalItems = await posts.CountAsync();
        totalPages = (int)Math.Ceiling(totalItems / (double)paginationNumber);

        if (totalPages == 0)
        {
            postCardItems = [];
            return;
        }

        pageNumber = Math.Min(pageNumber, totalPages - 1);
        postCardItems = await posts
            .OrderByDescending(p => p.PublishDate)
            .Skip(pageNumber * paginationNumber)
            .Take(paginationNumber)
            .Select((p) => new PostCardItem {
                Slug = p.Slug,
                Title = p.Title,
                ViewCount = p.ViewCount,
                PublishDate = p.PublishDate,
                ThumbnailPath = p.ThumbnailPath,
                ReadTimeSeconds = p.ReadTimeSeconds,
                Tags = PostCardItem.SetTags(p.Tags),
                Contetnt = PostCardItem.PreviewContent(p.Content, 128)
            })
            .ToListAsync();
    }

    async Task HandleSearchInput(ChangeEventArgs args)
    {
        textInput = args.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(textInput))
        {
            await LoadPageAsync(0);
        }
    }
}