@page "/view/{slug}"
@page "/blog/{slug}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using PersonalBlog.Components.Shared
@using PersonalBlog.Data
@using PersonalBlog.Services.Redis

@inject ApplicationDbContext dbContext
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider authenticationStateProvider
@inject IHttpContextAccessor httpContextAccessor
@inject IHyperLogLogStore hyperLogLogStore

<div class="mx-2 m-sm-5 mt-3">
    <div class="content-container article-content d-flex flex-column">
        @((MarkupString)content!)
    </div>
    <span class="content-end-marker" data-article-end aria-hidden="true"></span>
</div>

<button class="scroll-to-top" data-scroll-to-top type="button" aria-label="Scroll to top" aria-hidden="true" tabindex="-1">
    <i class="bi bi-arrow-up" aria-hidden="true"></i>
</button>

<div class="d-flex justify-content-center my-4">
    <div class="like-btn-container text-light">
        <div>
            <p class="mb-1">Smash this like button if you found this post useful.</p>
        </div>
        <button id="btn-like" class="btn btn-like py-2 @(isLiked ? "liked" : string.Empty)"
                data-post-id="@id"
                data-liked="@isLiked.ToString().ToLowerInvariant()"
                data-authenticated="@((!string.IsNullOrWhiteSpace(currentUsername)).ToString().ToLowerInvariant())">
            <i class="bi @(isLiked ? "bi-hand-thumbs-up-fill" : "bi-hand-thumbs-up")"></i>
        </button>
        <span id="like-count" class="badge text-bg-secondary">@initialLikeCount</span>
        <span class="small text-danger" data-post-like-status role="status" aria-live="polite"></span>
    </div>
</div>

@* AI GENERATED CODE BEGINS *@
<Comment>
    <ChildContent>
        <section class="container my-5"
                 data-comments-loader
                 data-post-id="@id"
                 data-page-size="10"
                 data-authenticated="@((!string.IsNullOrWhiteSpace(currentUsername)).ToString().ToLowerInvariant())"
                 aria-labelledby="comments-heading">
            <div class="mx-auto" style="max-width: 500px;">
                <h2 id="comments-heading" class="h4 mb-3">Comments</h2>
                <div class="card border shadow-sm mb-4">
                    <div class="card-body">
                        <h3 class="h5 card-title">New Comment</h3>
                        @if (!string.IsNullOrWhiteSpace(currentUsername))
                        {
                            <form data-new-comment-form data-post-id="@id" data-username="@currentUsername">
                                <label class="form-label" for="new-comment-content">Write a comment</label>
                                <textarea class="form-control mb-2"
                                          id="new-comment-content"
                                          name="content"
                                          rows="4"
                                          maxlength="512"
                                          required
                                          placeholder="Share your thoughts…"></textarea>
                                <div class="d-flex justify-content-between align-items-center gap-3">
                                    <small class="text-muted">Up to 512 characters.</small>
                                    <button class="btn btn-primary post-comment-submit" type="submit" data-new-comment-submit>
                                        Post comment
                                    </button>
                                </div>
                                <p class="small mt-2 mb-0" data-new-comment-status role="status" aria-live="polite"></p>
                            </form>
                        }
                        else
                        {
                            <p class="mb-0">Please <a href="/auth/login">sign in</a> to leave a comment.</p>
                        }
                    </div>
                </div>
                <div data-comments-list aria-live="polite"></div>
                <p class="text-muted mb-3" data-comments-status role="status">Comments will load as you scroll.</p>
                <button class="btn btn-outline-primary btn-sm" type="button" data-comments-more hidden>
                    Load more comments
                </button>
            </div>
        </section>
    </ChildContent>
</Comment>
@* AI GENERATED CODE ENDS *@

@code {
    [Parameter] [SupplyParameterFromQuery]
    public string? slug { get; set; }

    string? content;
    string? id;
    string? initialLikeCount;
    string? currentUsername;
    bool isLiked;

    protected override async Task OnInitializedAsync()
    {
        var res = dbContext.Posts
            .Include(p => p.LikedByUsers)
            .FirstOrDefault(p => p.Slug == slug);

        if (res is null)
        {
            navigationManager.NavigateTo("/not-found");
            return;
        }

        content = res.Content;
        id = res.Id.ToString();
        initialLikeCount = res.LikedByUsers.Count.ToString();

        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        var username = authState.User.Identity?.Name;
        currentUsername = username;

        if (!string.IsNullOrWhiteSpace(username))
        {
            var currentUser = await dbContext.Users.FirstOrDefaultAsync(u => u.UserName == username);
            if (currentUser is not null)
            {
                isLiked = res.LikedByUsers.Any(u => u.Id == currentUser.Id);
            }
        }

        var visitorId = httpContextAccessor.HttpContext!.Items["visitor_id"]?.ToString();
        await AddView(res.Id.ToString(), visitorId!);
    }

    async Task AddView(string postId, string visitorId)
    {
        if(string.IsNullOrEmpty(postId) || string.IsNullOrEmpty(visitorId)) return;

        string key = $"Post:{postId}:views";
        await hyperLogLogStore.AddAsync(key, visitorId);
    }
}