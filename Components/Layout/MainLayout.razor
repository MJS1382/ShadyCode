@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<header class="bg-dark shadow-lg">
    <div class="header">
        <div class="row g-0">
            <div class="col-5 col-sm d-flex justify-content-start align-items-center text-center">
                <i class="bi bi-bootstrap ms-2" alt="Logo"></i>
                <span class="ms-2">Shady Code</span>
            </div>
            <div class="col">
                <Navbar/>
            </div>
            <div class="col-5 col-sm d-flex justify-content-end align-items-center">
                <button class="btn btn-outline-light mx-1">
                    <i class="bi bi-search" alt="search"></i>
                </button>
                <button class="btn btn-outline-light mx-1">
                    <AuthorizeView>
                        <Authorized>
                            <NavLink href="/account" class="text-decoration-none text-light">
                                <i class="bi bi-person-circle" alt="Account"></i>
                            </NavLink>
                        </Authorized>
                        <NotAuthorized>
                            <NavLink href="/auth/register" class="text-decoration-none text-light">
                                <i class="bi bi-person-circle" alt="Account"></i>
                            </NavLink>
                        </NotAuthorized>
                    </AuthorizeView>
                </button>
                @* <button class="btn btn-outline-light mx-1">
                    <i class="bi bi-translate" alt="Language"></i>
                </button> *@
                <button class="btn btn-outline-light mx-1">
                    <i class="bi bi-moon" alt="Theme"></i>
                </button>
            </div>
        </div>
    </div>
</header>

<div class="main container-fluid" style="height: 100%; min-height: 100vh;">
    @Body
</div>

<footer>
    <div class="footer bg-dark text-light sticky-bottom">
        &copy; 2026 Shady Code. All rights reserved.
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>